{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "general",
  "experimental": {
    "subagent_depth": 2
  },
  "websearch": {
    "provider": "firecrawl"
  },
  "agents": {
	"build": { "disabled": true },
    "plan": { "disabled": true },
    "general": { "disabled": true },
    "explore": { "disabled": true }
  },
  "plugins": [
    "opencode-claude-auth-v2@latest",
    "./integrations/plannotator"
  ],
  "mcp": {
    "servers": {
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp",
        "enabled": true
      },
      "browse": {
        "type": "local",
        "command": [
          "/home/mbv/.local/bin/browse",
          "mcp"
        ],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update"
        }
      }
    }
  }
}
