{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-opus-5-5",
  "default_agent": "build",
  "websearch": {
    "provider": "firecrawl"
  },
  // Agents run in a disposable remote env, so destructive commands are allowed.
  // The guard that matters is reading secrets. Agent rules are appended after
  // these, so agents must not add broad `read` or `shell` allows or they would
  // override the asks below.
  "permissions": [
    { "action": "shell", "resource": "git push*", "effect": "ask" },

    // Secret files: read tool. Patterns have no leading `/` so they match both
    // project-relative and absolute paths.
    { "action": "read", "resource": "*.env", "effect": "ask" },
    { "action": "read", "resource": "*.env.*", "effect": "ask" },
    { "action": "read", "resource": "*.envrc", "effect": "ask" },
    { "action": "read", "resource": "*.ssh/*", "effect": "ask" },
    { "action": "read", "resource": "*.gnupg/*", "effect": "ask" },
    { "action": "read", "resource": "*.aws/*", "effect": "ask" },
    { "action": "read", "resource": "*.kube/*", "effect": "ask" },
    { "action": "read", "resource": "*.azure/*", "effect": "ask" },
    { "action": "read", "resource": "*.config/gcloud/*", "effect": "ask" },
    { "action": "read", "resource": "*.config/incus/*", "effect": "ask" },
    { "action": "read", "resource": "*.config/gh/hosts.yml", "effect": "ask" },
    { "action": "read", "resource": "*.config/eregion-test-git-token", "effect": "ask" },
    { "action": "read", "resource": "*.docker/config.json", "effect": "ask" },
    { "action": "read", "resource": "*.docker/.token_seed*", "effect": "ask" },
    { "action": "read", "resource": "*.claude/.credentials.json", "effect": "ask" },
    { "action": "read", "resource": "*.claude/daemon/*.key", "effect": "ask" },
    { "action": "read", "resource": "*auth.json", "effect": "ask" },
    { "action": "read", "resource": "*secrets.json", "effect": "ask" },
    { "action": "read", "resource": "*.orca/*secret*", "effect": "ask" },
    { "action": "read", "resource": "*.orca/*.token", "effect": "ask" },
    { "action": "read", "resource": "*.local/share/opencode/opencode.db*", "effect": "ask" },
    { "action": "read", "resource": "*.netrc", "effect": "ask" },
    { "action": "read", "resource": "*.git-credentials", "effect": "ask" },
    { "action": "read", "resource": "*.pgpass", "effect": "ask" },
    { "action": "read", "resource": "*.vault-token", "effect": "ask" },
    { "action": "read", "resource": "*_history", "effect": "ask" },
    { "action": "read", "resource": "*.pem", "effect": "ask" },
    { "action": "read", "resource": "*.key", "effect": "ask" },
    { "action": "read", "resource": "*.p12", "effect": "ask" },
    { "action": "read", "resource": "*.pfx", "effect": "ask" },
    { "action": "read", "resource": "*.tfvars", "effect": "ask" },
    { "action": "read", "resource": "*id_rsa*", "effect": "ask" },
    { "action": "read", "resource": "*id_ecdsa*", "effect": "ask" },
    { "action": "read", "resource": "*id_ed25519*", "effect": "ask" },
    { "action": "read", "resource": "/proc/*/environ", "effect": "ask" },
    // ...except public keys and env templates
    { "action": "read", "resource": "*.pub", "effect": "allow" },
    { "action": "read", "resource": "*.ssh/known_hosts", "effect": "allow" },
    { "action": "read", "resource": "*.env.example", "effect": "allow" },
    { "action": "read", "resource": "*.env.sample", "effect": "allow" },
    { "action": "read", "resource": "*.env.template", "effect": "allow" },

    // Secret files: shell commands that mention them. This is best-effort
    // text matching and is easy to bypass on purpose.
    { "action": "shell", "resource": "*.env", "effect": "ask" },
    { "action": "shell", "resource": "*.env *", "effect": "ask" },
    { "action": "shell", "resource": "*.env.*", "effect": "ask" },
    { "action": "shell", "resource": "*.envrc*", "effect": "ask" },
    { "action": "shell", "resource": "*.ssh/*", "effect": "ask" },
    { "action": "shell", "resource": "*.gnupg*", "effect": "ask" },
    { "action": "shell", "resource": "*.aws/*", "effect": "ask" },
    { "action": "shell", "resource": "*.kube/*", "effect": "ask" },
    { "action": "shell", "resource": "*.azure/*", "effect": "ask" },
    { "action": "shell", "resource": "*gcloud/*", "effect": "ask" },
    { "action": "shell", "resource": "*incus/*", "effect": "ask" },
    { "action": "shell", "resource": "*hosts.yml*", "effect": "ask" },
    { "action": "shell", "resource": "*eregion-test-git-token*", "effect": "ask" },
    { "action": "shell", "resource": "*.docker/config.json*", "effect": "ask" },
    { "action": "shell", "resource": "*.token_seed*", "effect": "ask" },
    { "action": "shell", "resource": "*.credentials.json*", "effect": "ask" },
    { "action": "shell", "resource": "*auth.json*", "effect": "ask" },
    { "action": "shell", "resource": "*secrets.json*", "effect": "ask" },
    { "action": "shell", "resource": "*.orca/*", "effect": "ask" },
    { "action": "shell", "resource": "*opencode.db*", "effect": "ask" },
    { "action": "shell", "resource": "*.netrc*", "effect": "ask" },
    { "action": "shell", "resource": "*.git-credentials*", "effect": "ask" },
    { "action": "shell", "resource": "*.pgpass*", "effect": "ask" },
    { "action": "shell", "resource": "*.vault-token*", "effect": "ask" },
    { "action": "shell", "resource": "*_history*", "effect": "ask" },
    { "action": "shell", "resource": "*.pem", "effect": "ask" },
    { "action": "shell", "resource": "*.pem *", "effect": "ask" },
    { "action": "shell", "resource": "*.key", "effect": "ask" },
    { "action": "shell", "resource": "*.key *", "effect": "ask" },
    { "action": "shell", "resource": "*.p12*", "effect": "ask" },
    { "action": "shell", "resource": "*.pfx*", "effect": "ask" },
    { "action": "shell", "resource": "*.tfvars*", "effect": "ask" },
    { "action": "shell", "resource": "*id_rsa*", "effect": "ask" },
    { "action": "shell", "resource": "*id_ecdsa*", "effect": "ask" },
    { "action": "shell", "resource": "*id_ed25519*", "effect": "ask" },
    { "action": "shell", "resource": "*/environ*", "effect": "ask" },

    // Commands that print secrets from the environment or credential stores
    { "action": "shell", "resource": "env", "effect": "ask" },
    { "action": "shell", "resource": "env -0*", "effect": "ask" },
    { "action": "shell", "resource": "printenv *", "effect": "ask" },
    { "action": "shell", "resource": "set", "effect": "ask" },
    { "action": "shell", "resource": "export", "effect": "ask" },
    { "action": "shell", "resource": "export -p*", "effect": "ask" },
    { "action": "shell", "resource": "declare -p*", "effect": "ask" },
    { "action": "shell", "resource": "declare -x*", "effect": "ask" },
    { "action": "shell", "resource": "compgen -e*", "effect": "ask" },
    { "action": "shell", "resource": "*$*TOKEN*", "effect": "ask" },
    { "action": "shell", "resource": "*$*SECRET*", "effect": "ask" },
    { "action": "shell", "resource": "*$*PASSWORD*", "effect": "ask" },
    { "action": "shell", "resource": "*$*API_KEY*", "effect": "ask" },
    { "action": "shell", "resource": "*$*CREDENTIAL*", "effect": "ask" },
    { "action": "shell", "resource": "gh auth token*", "effect": "ask" },
    { "action": "shell", "resource": "gh auth status *--show-token*", "effect": "ask" },
    { "action": "shell", "resource": "gh secret *", "effect": "ask" },
    { "action": "shell", "resource": "git credential*", "effect": "ask" },
    { "action": "shell", "resource": "git config *credential*", "effect": "ask" },
    { "action": "shell", "resource": "secret-tool *", "effect": "ask" },
    { "action": "shell", "resource": "gpg *--export-secret*", "effect": "ask" },
    { "action": "shell", "resource": "aws configure *", "effect": "ask" },
    { "action": "shell", "resource": "kubectl get secret*", "effect": "ask" },
    { "action": "shell", "resource": "docker inspect *", "effect": "ask" },
    { "action": "shell", "resource": "docker exec * env*", "effect": "ask" }
  ],
  // Policies apply after every agent's rules. Agents use the read/edit/write
  // tools instead of programming languages; shell tools like sed and awk are fine.
  "policies": [
    // Scripting languages: blocked entirely
    { "action": "tool.use", "resource": "shell:python*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:uv run python*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:perl*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:ruby*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:php*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:lua*", "effect": "deny" },
    // ...except running a project's Python tests
    { "action": "tool.use", "resource": "shell:python -m pytest *", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:python3 -m pytest *", "effect": "allow" },
    { "action": "tool.use", "resource": "shell:uv run python -m pytest *", "effect": "allow" },

    // JS runtimes also run project builds and tests, so only block inline code
    { "action": "tool.use", "resource": "shell:node -e *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:node --eval *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:node -p *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:node --print *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:node", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:node - *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:node <*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:bun -e *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:bun --eval *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:bun -p *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:bun --print *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:deno eval *", "effect": "deny" }
  ],
  "agents": {
    "plan": { "disabled": true },
    "build": { "color": "#4f9dff", "model": "anthropic/claude-opus-5-5#medium" }
  },
  "plugins": [
    "opencode-claude-auth-v2@latest",
    "@plannotator/opencode@latest"
  ]
}
